# Postgres пилота — StatefulSet + PVC + TLS (R-D1–D3)
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: acom-offer-desk-pilot
spec:
  serviceName: postgres
  replicas: 1
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
        acom.security/tier: data
    spec:
      containers:
        - name: postgres
          image: postgres:16-alpine
          ports:
            - containerPort: 5432
          envFrom:
            - secretRef:
                name: acom-app-secrets
          volumeMounts:
            - name: pg-data
              mountPath: /var/lib/postgresql/data
            - name: pg-tls
              mountPath: /etc/ssl/postgres
              readOnly: true
      volumes:
        - name: pg-tls
          secret:
            secretName: postgres-tls
  volumeClaimTemplates:
    - metadata:
        name: pg-data
      spec:
        accessModes: ["ReadWriteOnce"]
        resources:
          requests:
            storage: 20Gi
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: acom-offer-desk-pilot
spec:
  type: ClusterIP
  selector:
    app: postgres
  ports:
    - port: 5432
      targetPort: 5432
