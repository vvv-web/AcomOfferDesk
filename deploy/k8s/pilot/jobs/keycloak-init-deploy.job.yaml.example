# Job: логика scripts/keycloak-init-deploy.sh (skip bootstrap если model OK)
apiVersion: batch/v1
kind: Job
metadata:
  name: keycloak-init-deploy
  namespace: acom-offer-desk-pilot
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: init
          image: CHANGE_ME_REGISTRY/acom-backend@sha256:CHANGE_ME_DIGEST
          command: ["/bin/sh", "/app/scripts/keycloak-init-deploy.sh"]
          env:
            - name: COMPOSE_ENV_FILE
              value: "/dev/null"
            # Job передаёт env через envFrom; скрипт адаптировать или wrapper
          envFrom:
            - secretRef:
                name: acom-app-secrets
